menu "MPPT Configuration"

config MPPT_ALGO
    string "Algorithme MPPT (pno/inccond)"
    default "pno"

config MPPT_SAMPLE_PERIOD_MS
    int "Période d'échantillonnage (ms)"
    default 20
    range 5 1000

config MPPT_DUTY_STEP
    int "Pas de perturbation du duty (LEDC ticks)"
    default 8
    range 1 512

config MPPT_DUTY_MIN
    int "Duty minimum (%)"
    default 5
    range 0 50

config MPPT_DUTY_MAX
    int "Duty maximum (%)"
    default 95
    range 50 100

endmenu
